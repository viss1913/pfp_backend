# Абсолютная база API для ссылок на PDF из конструкторского site-chat (фронт на другом домене).
# Пример: https://pfpbackend-production.up.railway.app/api
# Если не задано — пробуется RAILWAY_PUBLIC_DOMAIN; без этого fallback-ссылка после расчёта не соберётся.
# PFP_PUBLIC_API_BASE_URL=

# Принудительно выставить agents.id для constructor_bots (и при необходимости project_id с карточки агента).
# Работает даже если у бота уже был другой agent_id — иначе env не применялся.
# Агент должен быть в том же project_id, что и бот (или у бота project_id пустой — подтянется с агента).
# CONSTRUCTOR_BACKFILL_AGENT_ID=10045

# --- LLM (OpenRouter): конструктор, Telegram, чаты и т.д. — см. src/services/aiService.js ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it
# Optional override for report executive summary generation
OPENROUTER_MODEL_SUMMARY=google/gemma-3-27b-it
# Optional override for risk profile explanation text generation
OPENROUTER_MODEL_RISK_PROFILE_EXPLANATION=google/gemma-3-27b-it
# Disable LLM generation for risk profile explanation (fallback-only mode)
# AI_RISK_PROFILE_EXPLANATION_ENABLED=true

MYSQLDATABASE=railway
MYSQLHOST=mysql.railway.internal
MYSQLPASSWORD=TOtYPvmAZPbRDViYPsQxdMxsnrUQByUm
MYSQLPORT=3306
MYSQLUSER=root
MYSQL_PUBLIC_URL=mysql://root:TOtYPvmAZPbRDViYPsQxdMxsnrUQByUm@maglev.proxy.rlwy.net:43619/railway

# Comon (опционально): переопределить путь списка стратегий относительно COMON_BASE_URL / https://www.comon.ru
# COMON_STRATEGIES_LIST_PATH=/api/v2/strategies
# COMON_COOKIE=
# COMON_HTTP_TIMEOUT_MS=20000
# Повторы при сбоях сети / 502–504 / 429 (число *дополнительных* попыток после первой; по умолчанию 2)
# COMON_HTTP_RETRIES=2
# Базовая задержка backoff (мс) между попытками: base * 2^attempt
# COMON_HTTP_RETRY_BASE_MS=500
# Исходящий HTTP CONNECT-прокси только для запросов к Comon (обход 403 с IP датацентра). Не путать с глобальным HTTP_PROXY.
# COMON_PROXY_URL=http://user:pass@your-proxy-host:3128
# Ручной JSON-источник витрины Comon (массив стратегий или { items: [...] }).
# По умолчанию: data/comonRecommendedStrategies.json
# COMON_SHOWCASE_SOURCE_FILE=data/comonRecommendedStrategies.json

# --- AV Inform / Resolut (см. docs/partners/RESOLUT_HYBRID_IMPLEMENTATION_NOTES.md) ---
# RESOLUT_BASE_URL=https://demo.avinfors.ru/pfp/api/pfp/
# RESOLUT_PROJECT_ID=23
# Таймаут HTTP к Resolut (мс): в коде ограничен диапазоном 8000–120000; значения ниже 8000 поднимаются до 8000.
# RESOLUT_TIMEOUT_MS=10000
# RESOLUT_STATIC_KEY=
# RESOLUT_SESSION_TTL_MS=82800000
# RESOLUT_NSJ_PFP_CODE=assetShort
# Проекты с PDF на HTML-шаблонах Finam (через запятую; по умолчанию 14,23)
# FINAM_REPORT_PROJECT_IDS=14,23

# База URL страницы регистрации агента (invite-link, письмо субагенту). Query: project_key, ref, UTM.
# AGENT_REGISTER_BASE_URL=https://pfp-front-ver3.vercel.app/register
# FRONTEND_AGENT_REGISTER_URL=  # алиас

# --- Resend (транзакционная почта, см. src/services/emailService.js) ---
# API-ключ из https://resend.com/api-keys — в проде только через секреты хостинга/CI, не коммитить.
RESEND_API_KEY=
# Отправитель: адрес с верифицированного в Resend домена.
# Вариант 1 — общий ящик: PFP <noreply@bank-future.com>
# Вариант 2 — NDA с ящика агента на вашем домене (плейсхолдер {agent}):
#   RESEND_FROM_EMAIL={agent}@bank-future.com
#   Локальная часть: agents.email_corp (только ящик, без @domain), иначе из email агента, если домен совпадает; иначе agent_<id>.
# Для писем без агента (код регистрации) при шаблоне {agent} используется: RESEND_SYSTEM_LOCAL@тот_же_домен (по умолчанию noreply).
# RESEND_SYSTEM_LOCAL=noreply
# RESEND_FROM_EMAIL=
#
# NDA: в «От» ещё и отображаемое ФИО консультанта (отключить: NDA_FROM_USE_AGENT_NAME=0).
# NDA_REPLY_TO_AGENT=1 — Reply-To на email агента (0 — выкл.).

# Город в преамбуле NDA (см. src/services/ndaService.js), по умолчанию Москва.
# NDA_AGREEMENT_CITY=Москва

# NDA: URL публичной оферты и политики ПДн (подставляются в текст соглашения).
# NDA_PUBLIC_OFFER_URL=https://...
# NDA_PRIVACY_POLICY_URL=https://...
# (Не используется) раньше — реквизиты в таблице консультанта в PDF NDA.
# NDA_CONSULTANT_LEGAL_REQUISITES=

# --- PDF (Puppeteer): src/utils/renderHtmlToPdfBuffer.js ---
# Таймаут setContent/page.pdf (мс), в коде ограничен 15000–300000.
# REPORT_PDF_NAV_TIMEOUT_MS=120000
# Пауза после load перед печатью в PDF (мс, 0–5000; по умолчанию 300). Если кривятся шрифты/iframe — поднять, например 450.
# REPORT_PDF_POST_LOAD_DELAY_MS=300
# Путь к Chrome/Chromium (иначе ищется по списку в коде).
# PUPPETEER_EXECUTABLE_PATH=
