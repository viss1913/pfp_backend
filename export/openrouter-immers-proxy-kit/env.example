# --- OpenRouter (LLM) ---
# Ключ: https://openrouter.ai/keys — в git НЕ класть
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-27b-it
OPENROUTER_HTTP_TIMEOUT_MS=30000

# --- Прокси egress (обязательно с Immers / многих DC в РФ) ---
# ПРОД (тот же SOCKS, что для Telegram на Vultr):
OPENROUTER_PROXY_URL=socks5://45.77.80.63:10809

# ЛОКАЛЬНО: сначала ssh -D 127.0.0.1:10809 -N root@45.77.80.63
# OPENROUTER_PROXY_URL=socks5://127.0.0.1:10809

# Fallback, если OPENROUTER_PROXY_URL пустой или только HTTP:
TELEGRAM_PROXY_URL=socks5://45.77.80.63:10809

# НЕ РАБОТАЕТ для OpenRouter (Squid 503) — не использовать:
# OPENROUTER_PROXY_URL=http://45.77.80.63:3128

# С auth, если настроишь на VPS:
# OPENROUTER_PROXY_URL=socks5://user:pass@45.77.80.63:10809
